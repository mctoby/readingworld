  m_Name: DailyContent
  m_EditorClassIdentifier: Assembly-CSharp::DailyContent
  characters:
  - npcId: librarian
    name: Mr. Page
    isHost: 1
    personality: The kind, slightly flustered librarian. His library became so popular that everyone borrowed books and nobody brought them back, so his shelves keep emptying. He starts each day and is overjoyed when the shelves fill up again.
    mission: 
    rewardBooks: 3
  - npcId: barnaby
    name: Old Barnaby
    isHost: 0
    personality: A gentle, forgetful old man who loves long meandering walks around the camp and is always losing things.
    mission: Three riddles about the topic. Each riddle is a multiple-choice question; Barnaby describes something and the reader picks what it is.
    rewardBooks: 3
  - npcId: tilly
    name: Tilly
    isHost: 0
    personality: A cheerful, curious girl who collects stories and loves telling them.
    mission: Tell a short original story about the topic (3-4 lines), then ask four multiple-choice questions about what happened in it.
    rewardBooks: 4
  - npcId: gus
    name: Gus
    isHost: 0
    personality: A friendly gardener who loves words as much as his vegetables.
    mission: Five sentences about the topic, each with one missing word. The reader picks the word that fills the gap.
    rewardBooks: 5
  days:
  - day: 2
    topic: Dinosaurs
    live: 1
